/* ISA-JSON Data Steward - Dark Theme */

/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
}

/* Sidebar */
QWidget#sidebar {
    background-color: #252526;
    color: #cccccc;
}

/* Sidebar title (U-09: self-contained chip so it stays legible even if the
   container background mis-renders) */
QLabel#sidebarTitle {
    color: #ffffff;
    background-color: #252526;
    font-size: 20px;
    font-weight: bold;
    padding: 20px 0;
}

/* Ensure scroll area inside sidebar has dark background */
QWidget#sidebar QScrollArea,
QWidget#sidebar QScrollArea > QWidget > QWidget {
    background-color: #252526;
}

QPushButton#sidebarButton {
    background-color: transparent;
    border: none;
    color: #cccccc;
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 4px;
}

QPushButton#sidebarButton:hover {
    background-color: #3e3e42;
}

QPushButton#sidebarButton:checked {
    background-color: #0e639c;
    font-weight: bold;
}

QPushButton#sidebarButton:checked:hover {
    background-color: #1177bb;
}

/* Content Area */
QWidget#contentArea, QWidget#contentPage {
    background-color: #1e1e1e;
}

/* ScrollablePage scroll viewports (U-03: the dark background must reach the
   scroll area / viewport / content widget, which are plain widgets the
   #contentPage rule alone never covers) */
QWidget#contentPage QScrollArea,
QWidget#contentPage QScrollArea > QWidget > QWidget {
    background-color: #1e1e1e;
}

/* Labels - base text color (parity with light.qss) */
QLabel {
    color: #cccccc;
}

/* Checkable controls (default palette text is black -> invisible here) */
QCheckBox, QRadioButton {
    color: #cccccc;
}

/* Cards */
QWidget#card {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    padding: 16px;
}

/* Buttons */
QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #0d5a8c;
}

QPushButton:disabled {
    background-color: #3e3e42;
    color: #6e6e6e;
}

QPushButton#primaryButton {
    background-color: #388a34;
}

QPushButton#primaryButton:hover {
    background-color: #4caf50;
}

QPushButton#dangerButton {
    background-color: #f14c4c;
}

QPushButton#dangerButton:hover {
    background-color: #ff6b6b;
}

/* U-14: disabled variants for the styled button classes.  The #id rules
   above out-specify the generic QPushButton:disabled rule, which would
   otherwise never apply to PrimaryButton/DangerButton -- disabled buttons
   kept their full color and looked enabled. */
QPushButton#primaryButton:disabled,
QPushButton#primaryButton:disabled:hover,
QPushButton#primaryButton:disabled:pressed {
    background-color: #3e3e42;
    color: #6e6e6e;
}

QPushButton#dangerButton:disabled,
QPushButton#dangerButton:disabled:hover,
QPushButton#dangerButton:disabled:pressed {
    background-color: #3e3e42;
    color: #6e6e6e;
}

/* Form Labels */
QLabel#formLabel {
    color: #cccccc;
    font-weight: 500;
    font-size: 13px;
}

/* Form Fields (N1: QDateEdit/QTimeEdit/QDateTimeEdit join the list -- they
   previously matched no rule and fell back to the light default palette) */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0e639c;
    background-color: #252526;
}

/* Text Browser (U-03: details/preview panels must not fall back to the
   light default palette) */
QTextBrowser {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    color: #cccccc;
    font-size: 12px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
}

/* Tree Widget */
QTreeWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    color: #cccccc;
}

QTreeWidget::item {
    padding: 4px;
    color: #cccccc;
}

QTreeWidget::item:hover {
    background-color: #2a2d2e;
    color: #cccccc;
}

QTreeWidget::item:selected {
    background-color: #0e639c;
    color: #ffffff;
}

/* Table Widget */
QTableWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    gridline-color: #3e3e42;
    color: #cccccc;
}

QTableWidget::item {
    padding: 4px;
    color: #cccccc;
}

QTableWidget::item:selected {
    color: #ffffff;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #3e3e42;
    border-right: 1px solid #3e3e42;
    font-weight: 500;
}

/* List Widget (U-03: lists must not fall back to the light default palette) */
QListWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    color: #cccccc;
}

QListWidget::item {
    padding: 4px;
    color: #cccccc;
}

QListWidget::item:hover {
    background-color: #2a2d2e;
    color: #cccccc;
}

QListWidget::item:selected {
    background-color: #0e639c;
    color: #ffffff;
}

/* Tree/Table views used inside dialogs */
QTreeView, QTableView {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    gridline-color: #3e3e42;
    color: #cccccc;
}

QTreeView::item, QTableView::item {
    padding: 4px;
    color: #cccccc;
}

QTreeView::item:hover, QTableView::item:hover {
    background-color: #2a2d2e;
    color: #cccccc;
}

QTreeView::item:selected, QTableView::item:selected {
    background-color: #0e639c;
    color: #ffffff;
}

/* Abstract Item View - General (parity with light.qss) */
QAbstractItemView {
    background-color: #1e1e1e;
    color: #cccccc;
}

QAbstractItemView::item {
    color: #cccccc;
}

QAbstractItemView::item:selected {
    color: #ffffff;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e4e4e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4e4e4e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    font-size: 12px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #3e3e42;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    text-align: center;
    background-color: #2d2d30;
    color: #cccccc;
}

QProgressBar::chunk {
    background-color: #0e639c;
    border-radius: 3px;
}

/* Spin Box (N1: date/time edits share the spin chrome; N2 chip fix applied
   here too -- transparent buttons so no palette-gray remnant survives) */
QSpinBox::up-button, QDoubleSpinBox::up-button,
QDateEdit::up-button, QTimeEdit::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border: none;
    border-left: 1px solid #3e3e42;
    background-color: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button,
QDateEdit::down-button, QTimeEdit::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border: none;
    border-left: 1px solid #3e3e42;
    border-top: 1px solid #3e3e42;
    background-color: transparent;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover,
QDateEdit::up-button:hover, QTimeEdit::up-button:hover, QDateTimeEdit::up-button:hover,
QDateEdit::down-button:hover, QTimeEdit::down-button:hover, QDateTimeEdit::down-button:hover {
    background-color: #3e3e42;
}

/* Combo Box (N2: the drop-down chip needs its own background or it paints
   the default palette's light gray over the dark field) */
QComboBox::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #cccccc;
}

/* Date/Time edits with a calendar drop-down (N1): chip mirrors the combo
   block, including the N2 transparent-background fix */
QDateEdit::drop-down, QTimeEdit::drop-down, QDateTimeEdit::drop-down {
    border: none;
    width: 20px;
    background-color: transparent;
}

QDateEdit::down-arrow, QTimeEdit::down-arrow, QDateTimeEdit::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #cccccc;
}

/* Tooltip & Menu (X-3: the last light-palette remnants in dark theme) */
QToolTip {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #3e3e42;
}

QMenu {
    background-color: #2d2d30;
    color: #cccccc;
    border: 1px solid #3e3e42;
}

QMenu::item:selected {
    background-color: #0e639c;
    color: #ffffff;
}

QComboBox QAbstractItemView {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
}

/* Dialog (parity with light.qss: dialogs share the dark surface) */
QDialog {
    background-color: #1e1e1e;
    color: #cccccc;
}

QDialog QLabel {
    color: #cccccc;
}

QDialog QTextEdit {
    color: #cccccc;
    background-color: #3c3c3c;
}

/* Semantic label roles (U-03: uiRole dynamic property replaces inline
   light-theme stylesheets; QSS is the single theming source) */
QLabel[uiRole="muted"] {
    color: #9a9a9a;
}

QLabel[uiRole="statValue"] {
    color: #ecf0f1;
}

QLabel[uiRole="error"] {
    color: #ff6b6b;
}

QLabel[uiRole="success"] {
    color: #6cc76c;
}

QLabel[uiRole="warning"] {
    color: #f5b041;
}

/* Panel role (U-03: details/preview card frames keep box metrics inline,
   colors come from QSS) */
QFrame[uiRole="panel"] {
    background-color: #252526;
    border: 1px solid #3e3e42;
}
