/* ISA-JSON Data Steward - Dark Theme */

/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
}

/* Sidebar */
QWidget#sidebar {
    background-color: #252526;
    color: #cccccc;
}

/* Sidebar title */
QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    padding: 20px 0;
}

/* Ensure scroll area inside sidebar has dark background */
QWidget#sidebar QScrollArea,
QWidget#sidebar QScrollArea > QWidget > QWidget {
    background-color: #252526;
}

QPushButton#sidebarButton {
    background-color: transparent;
    border: none;
    color: #cccccc;
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 4px;
}

QPushButton#sidebarButton:hover {
    background-color: #3e3e42;
}

QPushButton#sidebarButton:checked {
    background-color: #0e639c;
    font-weight: bold;
}

QPushButton#sidebarButton:checked:hover {
    background-color: #1177bb;
}

/* Content Area */
QWidget#contentArea {
    background-color: #1e1e1e;
}

/* Cards */
QWidget#card {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    border-radius: 8px;
    padding: 16px;
}

/* Buttons */
QPushButton {
    background-color: #0e639c;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #0d5a8c;
}

QPushButton:disabled {
    background-color: #3e3e42;
    color: #6e6e6e;
}

QPushButton#primaryButton {
    background-color: #388a34;
}

QPushButton#primaryButton:hover {
    background-color: #4caf50;
}

QPushButton#dangerButton {
    background-color: #f14c4c;
}

QPushButton#dangerButton:hover {
    background-color: #ff6b6b;
}

/* Form Labels */
QLabel#formLabel {
    color: #cccccc;
    font-weight: 500;
    font-size: 13px;
}

/* Form Fields */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0e639c;
    background-color: #252526;
}

/* Tree Widget */
QTreeWidget {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
}

QTreeWidget::item {
    padding: 4px;
}

QTreeWidget::item:hover {
    background-color: #2a2d2e;
}

QTreeWidget::item:selected {
    background-color: #0e639c;
    color: #ffffff;
}

/* Table Widget */
QTableWidget {
    background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 4px;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
    gridline-color: #3e3e42;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #3e3e42;
    border-right: 1px solid #3e3e42;
    font-weight: 500;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e4e4e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4e4e4e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    font-size: 12px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #2d2d30;
    color: #cccccc;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #3e3e42;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    text-align: center;
    background-color: #2d2d30;
    color: #cccccc;
}

QProgressBar::chunk {
    background-color: #0e639c;
    border-radius: 3px;
}

/* Spin Box */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border: none;
    border-left: 1px solid #3e3e42;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border: none;
    border-left: 1px solid #3e3e42;
    border-top: 1px solid #3e3e42;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #3e3e42;
}

/* Combo Box */
QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #cccccc;
}

QComboBox QAbstractItemView {
    background-color: #2d2d30;
    border: 1px solid #3e3e42;
    selection-background-color: #0e639c;
    selection-color: #ffffff;
}
