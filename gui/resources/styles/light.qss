/* ISA-JSON Data Steward - Light Theme */

/* Main Window */
QMainWindow {
    background-color: #f5f5f5;
}

/* Sidebar */
QWidget#sidebar {
    background-color: #2c3e50;
    color: #ecf0f1;
}

/* Sidebar title */
QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    padding: 20px 0;
}

/* Ensure scroll area inside sidebar has dark background */
QWidget#sidebar QScrollArea,
QWidget#sidebar QScrollArea > QWidget > QWidget {
    background-color: #2c3e50;
}

QPushButton#sidebarButton {
    background-color: transparent;
    border: none;
    color: #ecf0f1;
    text-align: left;
    padding: 12px 16px;
    font-size: 14px;
    border-radius: 4px;
}

QPushButton#sidebarButton:hover {
    background-color: #34495e;
}

QPushButton#sidebarButton:checked {
    background-color: #3498db;
    font-weight: bold;
}

QPushButton#sidebarButton:checked:hover {
    background-color: #2980b9;
}

/* Content Area */
QWidget#contentArea {
    background-color: #ffffff;
    color: #2c3e50;
}

/* Labels - Base style to ensure proper text color */
QLabel {
    color: #2c3e50;
}

/* Override label color in sidebar (white on dark) */
QWidget#sidebar QLabel {
    color: #ecf0f1;
}

/* Cards */
QWidget#card {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 16px;
}

/* Buttons */
QPushButton {
    background-color: #3498db;
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #21618c;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

QPushButton#primaryButton {
    background-color: #27ae60;
}

QPushButton#primaryButton:hover {
    background-color: #229954;
}

QPushButton#dangerButton {
    background-color: #e74c3c;
}

QPushButton#dangerButton:hover {
    background-color: #c0392b;
}

/* Form Labels */
QLabel#formLabel {
    color: #2c3e50;
    font-weight: 500;
    font-size: 13px;
}

/* Form Fields */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 8px;
    background-color: #ffffff;
    color: #2c3e50;
    font-size: 13px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3498db;
}

/* Tree Widget */
QTreeWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    color: #2c3e50;
}

QTreeWidget::item {
    padding: 4px;
    color: #2c3e50;
}

QTreeWidget::item:hover {
    background-color: #ecf0f1;
    color: #2c3e50;
}

QTreeWidget::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

/* Table Widget */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    gridline-color: #e0e0e0;
    color: #2c3e50;
}

QTableWidget::item {
    padding: 4px;
    color: #2c3e50;
}

QTableWidget::item:selected {
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ecf0f1;
    color: #2c3e50;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #bdc3c7;
    border-right: 1px solid #bdc3c7;
    font-weight: 500;
}

/* Scrollbar */
QScrollBar:vertical {
    background-color: #ecf0f1;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #ecf0f1;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #bdc3c7;
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Status Bar */
QStatusBar {
    background-color: #2c3e50;
    color: #ecf0f1;
    font-size: 12px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #e0e0e0;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #ecf0f1;
    color: #2c3e50;
    padding: 8px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #3498db;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #d5dbdb;
}

/* Group Box */
QGroupBox {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    text-align: center;
    background-color: #ecf0f1;
    color: #2c3e50;
}

QProgressBar::chunk {
    background-color: #3498db;
    border-radius: 3px;
}

/* Spin Box */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border: none;
    border-left: 1px solid #bdc3c7;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border: none;
    border-left: 1px solid #bdc3c7;
    border-top: 1px solid #bdc3c7;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #ecf0f1;
}

/* Combo Box */
QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #7f8c8d;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #bdc3c7;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    color: #2c3e50;
}

QComboBox QAbstractItemView::item {
    color: #2c3e50;
}

QComboBox QAbstractItemView::item:selected {
    color: #ffffff;
}

/* List Widget */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    selection-background-color: #3498db;
    selection-color: #ffffff;
    color: #2c3e50;
}

QListWidget::item {
    padding: 4px;
    color: #2c3e50;
}

QListWidget::item:hover {
    background-color: #ecf0f1;
    color: #2c3e50;
}

QListWidget::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

/* Dialog */
QDialog {
    background-color: #f5f5f5;
    color: #2c3e50;
}

QDialog QLabel {
    color: #2c3e50;
}

QDialog QTextEdit {
    color: #2c3e50;
    background-color: #ffffff;
}

/* Abstract Item View - General */
QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
}

QAbstractItemView::item {
    color: #2c3e50;
}

QAbstractItemView::item:selected {
    color: #ffffff;
}
